# Cloudflare Cache Purge — API token s "Zone > Cache Purge > Purge" permisijom
# Koristi se nakon deploya za automatski purge domovina.ai CDN cachea
CLOUDFLARE_PURGE_TOKEN=your_token_here
CLOUDFLARE_ZONE_ID=2eaa51e7e6896da6e92bde2ddd879cd8

# ─── Meilisearch keyword tražilica (opcionalno; deploy.sh embeda) ───
# Prod: https://search.domovina.ai. Bez ovoga klijent gađa lokalni dev (localhost:7700).
# MEILI_URL=https://search.domovina.ai
# MEILI_SEARCH_KEY je READ-ONLY (search-only); MeiliClient ima radni default pa je opcionalno.
# MEILI_SEARCH_KEY=
