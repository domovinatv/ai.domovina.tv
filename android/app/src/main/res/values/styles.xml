<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- LaunchTheme: aktivan dok Flutter engine ne nacrta prvi frame.
         STATIC verzija — pokazuje uvijek Mt 10,26 ("Ne bojte ih se dakle...").
         Razlog: Android <12 starting window se ne moze runtime-rotirati;
         SystemUI cita manifest theme drawable PRIJE Activity onCreate, i
         persistira do prvog Activity content frame-a (12-19s na sporijem
         hardveru). setTheme/setBackground iz onCreate nema vizualni efekt.
         Rotacija je zato premjestena u Flutter TvLoadingTips
         (lib/screens/tv/widgets/tv_loading_tips.dart) koji se renderira
         odmah kad Flutter prvi frame nacrta. Vidi docs/splash-bible-citations.md. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_bg</item>
    </style>

    <!-- NormalTheme: aktivan nakon prvog Flutter frame-a, behind Flutter UI.
         Black da se ne pojavljuje bijeli pulse pri navigaciji. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
