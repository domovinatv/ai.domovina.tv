<?xml version="1.0" encoding="utf-8"?>
<!-- Leanback launcher banner (320x180). Placeholder za Fazu 1: solid Croatian
     navy s launcher ikonom u centru. Za production zamijeniti s pravim 320x180
     PNG-om (hrvatska zastava + wordmark) u drawable-xhdpi/. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#002F6C" />
        </shape>
    </item>
    <item
        android:gravity="center"
        android:width="120dp"
        android:height="120dp">
        <bitmap
            android:src="@mipmap/ic_launcher"
            android:gravity="center" />
    </item>
</layer-list>
