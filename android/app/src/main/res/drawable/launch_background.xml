<?xml version="1.0" encoding="utf-8"?>
<!-- Native Android splash drawable. Premium full-frame (3840×2160) PNG —
     Mt 10,26-27 (KS Jeruzalemska Biblija). Identicna slika se prikazuje i
     u Flutter boot splash-u (lib/screens/tv/widgets/tv_boot_splash.dart)
     za seamless native→Flutter tranziciju. NormalTheme.windowBackground
     takodjer pointa na ovaj drawable da nema flash-a pri theme swap-u.

     Generirano scripts/generate-premium-splash-taglines.py (PRODUCTION_ONLY
     flag — generira samo #1; vidi script za regeneraciju svih 14 verzija).

     Vazno: native splash randomizacija nije moguca na Android <12 — vidi
     docs/splash-randomization-research.md. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item>
        <bitmap
            android:src="@drawable/splash_full_1"
            android:gravity="fill" />
    </item>
</layer-list>
